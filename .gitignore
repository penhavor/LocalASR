# --- project environment (created by bootstrap; never committed) ---
.venv/
venv/
env/

# --- user data (folders appear on demand while the app runs) ---
models/
outputs/
logs/
settings/
.cache/
*.log

# --- portable runtime: downloaded by RUN.bat on the first run ---
runtime/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# --- dev scratch (not part of the project) ---
.devtools/

# --- exe build artifacts (if you build one) ---
*.spec.bak
release/
